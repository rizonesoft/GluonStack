<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>../assets/brand/gluonstack.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Isotone.App</StartupObject>
    <AssemblyVersion>2025.10.6.31</AssemblyVersion>
    <FileVersion>2025.10.6.31</FileVersion>
    <!-- Output Path -->
    <BaseOutputPath>.\bin\</BaseOutputPath>
    <!-- Performance Optimizations -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.8" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Brand assets and fonts have one source, the repository's assets/ folder (docs/design/SPEC.md). -->
  <ItemGroup>
    <Resource Include="../assets/brand/gluonstack.ico" Link="assets/gluonstack.ico" />
    <Resource Include="../assets/brand/tray/*.ico" Link="assets/tray/%(Filename)%(Extension)" />
    <Resource Include="../assets/fonts/*.ttf" Link="assets/fonts/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
